if [[ $SKIP_HOOKS -gt 0 ]]; then
  echo "[PRE-COMMIT] skipping hooks (SKIP_HOOKS=$SKIP_HOOKS)"
  exit 0
fi

# ── Free the local Jekyll port (must stay first + synchronous) ────────────────
# A local `jekyll serve` watcher would re-touch files while the generators below
# write them, racing the commit. Kill only the process listening on THIS site's
# fixed port (4002) so a co-running sibling site's server survives. Runs in the
# FOREGROUND (no `&`) so sh blocks until the kill fully completes, then a short
# sleep lets the just-terminated server release the port and file handles before
# lint-staged touches files. Non-fatal: if nothing is listening the PowerShell
# pipeline is a no-op and the commit proceeds.
echo "[PRE-COMMIT] Ensuring no local Jekyll server holds port 4002 (waiting for kill to complete)..."
powershell.exe -NoProfile -Command "Get-NetTCPConnection -LocalPort 4002 -State Listen -ErrorAction SilentlyContinue | Select-Object -Expand OwningProcess -Unique | ForEach-Object { Stop-Process -Id \$_ -Force -ErrorAction SilentlyContinue }" 2>/dev/null || true
sleep 1 || true

# ── Format staged sources ─────────────────────────────────────────────────────
# Runs first so lint-staged's stash/restore of unstaged work never overlaps with
# the files the generators below write. Scoped to scripts/ only: Prettier
# collapses the {% comment %} blocks in the Liquid templates under _includes/
# and _layouts/, and reformatting the existing SCSS would bury real changes in
# hundreds of lines of noise. See .prettierignore for the full reasoning.
echo "[PRE-COMMIT] Run lint-staged"
npx lint-staged || {
  echo "[PRE-COMMIT] lint-staged reported errors it could not auto-fix. Fix them manually and try again."
  exit 1
}

# ── Regenerate committed artifacts ────────────────────────────────────────────
# All four generators run in well under a second and are idempotent, so they run
# on every commit rather than guessing which inputs matter. A conditional trigger
# would have to track ampscript-data and handlebars-data (both outside this
# repo), every *.md frontmatter block and the functions/ page list — getting that
# wrong reintroduces exactly the stale-artifact bug this hook exists to prevent.
#
# scripts/generate-tools.mjs and scripts/generate-site-content.mjs are
# deliberately NOT here: they render tracked pages from a catalog hard-coded in
# the script and from ../SFMC-Cookbook, and would silently revert hand-edits to
# tools/ and engagement/ on every commit.
echo "[PRE-COMMIT] 🔄 Regenerating _data/ampscript_functions.yml..."
node scripts/generate-ampscript-function-index.mjs || {
  echo "[PRE-COMMIT] ❌ The AMPscript function index could not be generated, so the commit was blocked"
  echo "[PRE-COMMIT]    to stop a stale _data/ampscript_functions.yml from being committed."
  echo "[PRE-COMMIT]    Usually a reference page under engagement/ampscript/functions/ has no"
  echo "[PRE-COMMIT]    matching function in ampscript-data (see the error above)."
  echo "[PRE-COMMIT]    Fix: correct the page filename so it matches the function name in"
  echo "[PRE-COMMIT]    lowercase, or add the function to ampscript-data/src/index.js."
  exit 1
}

echo "[PRE-COMMIT] 🔄 Regenerating _data/handlebars_helpers.yml..."
node scripts/generate-handlebars-helper-index.mjs || {
  echo "[PRE-COMMIT] ❌ The Handlebars helper index could not be generated, so the commit was blocked"
  echo "[PRE-COMMIT]    to stop a stale _data/handlebars_helpers.yml from being committed."
  echo "[PRE-COMMIT]    Usually a handlebarsEquivalent in ampscript-data points at a helper that"
  echo "[PRE-COMMIT]    does not exist in handlebars-data (see the error above)."
  echo "[PRE-COMMIT]    Fix: correct the handlebarsEquivalent value, or add the helper to"
  echo "[PRE-COMMIT]    handlebars-data/src/index.js."
  exit 1
}

echo "[PRE-COMMIT] 🔄 Regenerating _plugins/sfmc_catalogs.rb..."
node scripts/generate-rouge-lexer-data.mjs || {
  echo "[PRE-COMMIT] ❌ The Rouge lexer catalogs could not be generated, so the commit was blocked"
  echo "[PRE-COMMIT]    to stop a stale _plugins/sfmc_catalogs.rb from being committed."
  echo "[PRE-COMMIT]    Check the error above - usually a function or helper name that cannot be"
  echo "[PRE-COMMIT]    expressed in a Ruby %w[] word array."
  exit 1
}

echo "[PRE-COMMIT] 🔄 Regenerating site-index.json..."
node scripts/generate-site-index.mjs || {
  echo "[PRE-COMMIT] ❌ The site search index could not be generated, so the commit was blocked"
  echo "[PRE-COMMIT]    to stop a stale site-index.json from being committed."
  echo "[PRE-COMMIT]    Check the error above - usually a malformed frontmatter block."
  exit 1
}

# Re-staging is the whole point: regenerating without `git add` would still
# commit the stale blob that was staged before the hook ran.
git add _data/ampscript_functions.yml _data/handlebars_helpers.yml _plugins/sfmc_catalogs.rb site-index.json || {
  echo "[PRE-COMMIT] ❌ Could not stage the regenerated artifacts. See the error above."
  exit 1
}
echo "[PRE-COMMIT] ✅ Generated artifacts regenerated and staged."

# ── Strip UTF-8 BOMs (must stay last) ─────────────────────────────────────────
# Runs after everything else that writes files, so a BOM re-introduced by a
# generator or by Prettier still gets caught. A BOM before a page's opening
# `---` silently breaks Jekyll frontmatter parsing.
echo "[PRE-COMMIT] Checking staged files for UTF-8 BOMs..."
node scripts/check-bom.mjs || {
  echo "[PRE-COMMIT] ❌ BOM check failed. See the message above."
  exit 1
}

echo "[PRE-COMMIT] All checks passed."
