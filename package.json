{
  "name": "sfmc-guide-site",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling host for the sfmc.guide Jekyll site — husky hooks, generators and formatting only. Not a publishable package.",
  "type": "module",
  "author": "Joern Berkefeld <joern.berkefeld@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prepare": "husky || true",
    "serve": "bundle exec jekyll serve --source \"c:/EDF/Git/sfmc-amscript-language/sfmc.guide\" --destination \"c:/EDF/Git/sfmc-amscript-language/sfmc.guide/_site\" --port 4002 --host 127.0.0.1 --no-watch",
    "serve:live": "bundle exec jekyll serve --source \"c:/EDF/Git/sfmc-amscript-language/sfmc.guide\" --destination \"c:/EDF/Git/sfmc-amscript-language/sfmc.guide/_site\" --port 4002 --host 127.0.0.1 --livereload",
    "build": "bundle exec jekyll build --source \"c:/EDF/Git/sfmc-amscript-language/sfmc.guide\" --destination \"c:/EDF/Git/sfmc-amscript-language/sfmc.guide/_site\"",
    "generate:function-index": "node scripts/generate-ampscript-function-index.mjs",
    "generate:handlebars-index": "node scripts/generate-handlebars-helper-index.mjs",
    "generate:site-index": "node scripts/generate-site-index.mjs",
    "generate:lexer-data": "node scripts/generate-rouge-lexer-data.mjs",
    "generate:all": "npm run generate:function-index && npm run generate:handlebars-index && npm run generate:site-index && npm run generate:lexer-data",
    "check:bom": "node scripts/check-bom.mjs",
    "test": "node --test \"tests/**/*.test.cjs\"",
    "lint": "eslint \"assets/js/mcdev-pipeline-*.js\" \"tests/mcdev-pipeline-builders.test.cjs\"",
    "lint:fix": "eslint --fix \"assets/js/mcdev-pipeline-*.js\" \"tests/mcdev-pipeline-builders.test.cjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "scripts/**/*.{mjs,cjs,js}": [
      "prettier --write"
    ],
    "assets/js/mcdev-pipeline-*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
